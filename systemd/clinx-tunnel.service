[Unit]
Description=CLINX MCP tunnel-client runtime
After=network-online.target clinx-provider.service
Wants=network-online.target clinx-provider.service
# Install the full unit to remove a legacy PartOf=clinx.service dependency.
# An empty PartOf= in a drop-in cannot be relied on to remove that dependency.
# Fixed delay bounds retries; do not permanently lock out recovery after a burst.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/pvxlabs/dev/clinx
EnvironmentFile=%h/.config/tunnel-client/runtime.env
Environment=PATH=/home/pvxlabs/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pvxlabs/.local/bin/tunnel-client run --profile-dir %h/.config/tunnel-client --profile clinx-p620
Restart=always
RestartSec=10
KillMode=control-group

[Install]
WantedBy=default.target
