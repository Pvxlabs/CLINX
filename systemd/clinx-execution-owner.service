[Unit]
Description=CLINX persistent managed execution and Host delivery owner
After=network-online.target

[Service]
Type=simple
Environment=PATH=/home/pvxlabs/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/lib/clinx-control/launch-execution-owner
UMask=0077
Restart=on-failure
RestartSec=5
# SIGTERM stops admission and drains owned executions before exiting. Do not
# send termination to a running Host subprocess or force a timeout during drain.
KillMode=mixed
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
