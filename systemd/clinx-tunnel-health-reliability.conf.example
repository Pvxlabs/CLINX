# Companion to clinx-tunnel-reliability.conf.example. NOT INSTALLED.
# The old MainPID check expects tunnel-client itself; the new MainPID is the supervisor.
# Deploy only with the paired full-unit/CAS package from clinx-build build-tunnel-release.
[Service]
ExecStart=
ExecStart=/RELEASE/clinx-tunnel status --state-dir %h/.local/state/clinx/tunnel-reliability
