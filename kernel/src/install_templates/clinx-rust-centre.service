[Unit]
Description=CLINX Centre Rust projection (pre-cutover loopback)
After=clinx-rust-authority.service
Requires=clinx-rust-authority.service
[Service]
Environment=HOME=@ROOT@/api
Environment=CLINX_AUTHORITY=rust
Environment=CLINX_RUST_SOCKET=@RUN@/authority.sock
Environment=CLINX_RUST_UID=@AUTHORITY_UID@
User=clinx-api
Group=clinx-api
SupplementaryGroups=clinx-ipc clinx-provider-ipc
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
BindReadOnlyPaths=@RUN@-provider/native:/tmp/codex-daemon-@WORKER_UID@
ReadWritePaths=@ROOT@/api
InaccessiblePaths=@ROOT@/authority /home/@OPERATOR@/.codex /home/@OPERATOR@/.ssh /run/user/1001 -/run/docker.sock -/run/containerd
UMask=0077
KillMode=control-group
ExecStart=@RELEASE@/clinx-node-daemon --state @ROOT@/api/node-centre --node-id p620 serve --registry @ROOT@/api/node-centre/registry.sqlite3 --observations @ROOT@/api/node-centre/observations.sqlite3 --bind 127.0.0.1 --port 18774 --rust-projection --local-owner-host p620 --local-provider-config @ROOT@/config/bridge.toml --stale-after 45
Restart=on-failure
RestartSec=3
