#!/bin/sh
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
if [ "$#" -eq 0 ]; then
    set -- devices
fi
runtime=${CLINX_DEVICE_BINARY:-}
if [ -z "$runtime" ] && [ -n "${CLINX_NODE_BINARY:-}" ]; then
    runtime="$(dirname -- "$CLINX_NODE_BINARY")/clinx-device"
fi
if [ -z "$runtime" ] && [ -x "$repo_root/clinx-device" ]; then
    runtime="$repo_root/clinx-device"
fi
if [ -z "$runtime" ]; then
    runtime=$(command -v clinx-device || true)
fi
if [ -z "$runtime" ] || [ ! -x "$runtime" ]; then
    echo 'DEVICE_ERROR: RUST_DEVICE_BINARY_REQUIRED' >&2
    exit 2
fi
exec "$runtime" --config "$repo_root/bridge.toml" "$@"
