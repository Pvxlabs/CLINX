#!/bin/sh
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
observer=${CLINX_OBSERVER_BINARY:-$repo_root/clinx-observer}
if [ ! -x "$observer" ]; then
    echo 'Set CLINX_OBSERVER_BINARY to the verified clinx-observer release binary.' >&2
    exit 1
fi
exec "$observer" "$@"
