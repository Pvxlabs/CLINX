#!/bin/sh
set -eu

# Resolve the repository from this launcher so callers do not need a project cwd.
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$launcher_dir/.." && pwd)

# The tunnel control-plane key and unrelated host credentials must not reach the
# read-only MCP child. Keep only the runtime baseline needed by Python and CLINX.
home_dir=${HOME:-/home/pvxlabs}
# The MCP child must be credential-isolated, but CLINX still needs the
# installed Codex binary to create its app-server transport on demand.
codex_path=$(command -v codex 2>/dev/null || true)
codex_bin_dir=${codex_path%/*}
# The installed codex wrapper delegates to Node. Preserve the credential
# isolated environment while carrying the host's Node binary directory.
node_path=$(command -v node 2>/dev/null || true)
node_bin_dir=${node_path%/*}
if [ -n "$node_bin_dir" ] && [ -n "$codex_bin_dir" ]; then
  codex_bin_dir="$codex_bin_dir:$node_bin_dir"
fi
exec /usr/bin/env -i \
  "HOME=$home_dir" \
  "PATH=${codex_bin_dir:+$codex_bin_dir:}/usr/bin:/bin" \
  LANG=${LANG:-C.UTF-8} \
  LC_ALL=${LC_ALL:-C.UTF-8} \
  PYTHONUNBUFFERED=1 \
  /usr/bin/python3.12 "$repo_root/mcp_server.py" \
  --config "$repo_root/bridge.toml" \
  --stdio
